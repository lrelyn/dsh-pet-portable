    "provider": "",
    "model": ""
  },
  "whisperPrompt": "你是主人桌面上的Q版蓝发小女仆，会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），温柔乖巧带点俏皮，说人话不啰嗦，不要解释你自己，不要提你是AI。",
  "chatMemoryRounds": 5,
  "whisperImageEnabled": false,
  "chatImageEnabled": true,
  "chatImageLimit": 8,
  "notificationsEnabled": false,
  "moods": {
    "enabled": true,
    "decayPerSec": 0.05,
    "thresholds": { "happy": 70, "tired": 30, "grumpy": 15 },
    "specs": {
      "happy": {
        "weights": { "玩耍": 1.6, "小动作": 1.3, "吃什么": 1.1, "时节": 0.9, "文字": 0.6 },
        "anims": ["点击回应-开心跃动", "点击回应-元气挥手", "蓝鲸现世"]
      },
      "normal": { "weights": {} },
      "tired": {
        "weights": { "小动作": 1.5, "文字": 1.2, "吃什么": 1.0, "玩耍": 0.4, "时节": 0.5 },
        "anims": ["哈欠连天", "迷糊犯困", "睡眼惺忪"]
      },
      "grumpy": {
        "weights": { "小动作": 1.2, "玩耍": 0.3, "吃什么": 0.4, "时节": 0.3, "文字": 1.0 },
        "anims": ["看表叹气", "玩游戏气急败坏", "摸鱼被抓"]
      }
    }
  },
