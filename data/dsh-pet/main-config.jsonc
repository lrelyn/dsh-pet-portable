  // ===================== 独立版工作状态检测（前台窗口 → 六档） =====================
  // 背景：workStatus 六档原本靠 DSH 会话事件驱动（turn/start、tool/call…）。独立版没有
  // 宿主事件，那 6 段动画 + 18 句台词就一直躺着。这一段让它靠「前台窗口」反推状态。
  //
  // 原理：主进程常驻一个 PowerShell，每 detectIntervalSec 秒读一次前台窗口的
  //   进程名 + 标题（实测 50ms/次，Add-Type 只编译一次），广播给各宠物窗口；
  //   各窗口用自己的状态机映射成六档并驱动动画。
  //
  // 隐私：进程名/标题只在内存里做关键词匹配，不落盘、不上传、不记录。
  //
  // enabled: false 完全不启动（等价当前版本，一行代码都不跑）。

  // ===================== 精力 / 饱食（P2 第一批） =====================
  // 两个按小时级演化的维度，与 mood 的分钟级互补：
  //   mood    短期情绪，事件驱动，会快速回归
  //   energy  精力，工作消耗 / 睡眠恢复
  //   hunger  饱食，随时间下降 / 喂食恢复
  //
  // 速率全部用「每分钟」，数字好读。默认值按文档给：
  //   工作 1.5/分 → 约 53 分钟从满精力到疲惫
  //   饱食 0.4/分 → 约 4 小时从吃饱到饥饿
  //   睡眠 4/分   → 约 25 分钟从 0 到满
  //
  // enabled: false 完全不启动（等价当前版本，一行代码都不跑）。
  "vitals": {
    "enabled": true,
    "energy": {
      "initial": 80,
      // 干活累得快；玩也累但慢；待机几乎不动
      "workDrainPerMin": 1.5,
      "playDrainPerMin": 0.5,
      "idleDrainPerMin": 0.2,
      // 睡眠恢复：4/分 ≈ 25 分钟回满
      "sleepRecoverPerMin": 4,
      // 低于这个值 → 触发"累了"事件（调用方可据此自动入睡）
      "autoSleepThreshold": 15,
      // 睡到高于这个值 → 自然醒
      "wakeThreshold": 90
    },
    "hunger": {
      "initial": 70,
      "drainPerMin": 0.4,
      "workDrainPerMin": 0.6,
      "sleepDrainPerMin": 0.1,
      // 低于这些值 → 饥饿 / 饿坏
      "hungryThreshold": 30,
      "starvingThreshold": 15
    },
    // 四维联动（按文档 §2，但幅度收窄 —— 桌宠是陪玩的，不是养成压力工具）
    "coupling": {
      // 饿/累会让心情慢慢掉（叠加在 mood 自身回归之外）
      "hungryMoodDrainPerMin": 0.5,
      "tiredMoodDrainPerMin": 0.3,
      // 心情好 / 吃饱 时精力恢复更快
      "happyEnergyBonus": 1.2,
      "fullEnergyBonus": 1.3
    }
  },


  // ===================== 好感度 + 离线演化（P2 第二/三批） =====================
  //
  // affinity 与 mood 的区别：
  //   mood      短期情绪，分钟~小时，频繁波动，会 decay 回归
  //   affinity  长期关系，天~周，缓慢累积，只随长期缺席下降
  //
  // 六级：Lv1 陌生(0) / Lv2 认识(20) / Lv3 熟悉(40) / Lv4 亲密(60) / Lv5 羁绊(80) / Lv6 心灵相通(95)
  //
  // 每日上限是关键设计：没有它的话连点 100 下就刷满了，失去"长期"的意义。
  // 规则见代码 affinity.js 的 DAILY_RULES：
  //   每日首次互动 +2（1 次）/ 喂食 +1（3 次）/ 陪玩 +0.5（10 次）
  //   工作里程碑 +2（不限）/ 全天陪伴 +1（1 次）/ 及时照顾 +1.5（不限）
  "affinity": {
    "enabled": true,
    // 连续缺席多久开始掉好感（天）
    "decayAfterDays": 1
  },

  // 离线演化：桌宠关闭期间状态继续走，下次启动按离线时长推演并播回归剧情。
  //   精力：离线前 30 分钟按睡眠恢复，之后保持满（假设她自己睡了一觉）
  //   饱食：持续按睡眠速率消耗，扣到 0 为止
  //   心情：前 2 小时不变，之后每小时 -1（孤独）
  //   好感：见 affinity 的缺席规则（7 天以上触发"离家出走"彩蛋）
  "offline": {
    "enabled": true,
    // 自动存档间隔（分钟）
    "autosaveMin": 5,
    // 超过这么多天不回 → 离家出走彩蛋（可哄回，不是永久惩罚）
    "runawayAfterDays": 7
  },


  // ===================== 多宠社交（P2 第四批） =====================
  //
  // 复用已有的跨窗口位置广播（physics 的 reportFlight/onFlightStates），
  // 在物理碰撞之外加「关系值 + 社交互动」。
  //
  // 关系值（每两只之间独立，0~100，默认 50）：
  //   70~100 好朋友：贴贴/一起玩概率高，从不打架
  //   30~69  普通：各类型都有一点
  //   0~29   冤家：打架/追逐概率高，很少贴贴
  //
  // 注意：**不做双角色动画**（没有那个素材），改成单角色动画 + 位置对齐。
  // 所以贴贴看起来是「各自蹭一蹭」，不是两只抱在一起。
  "petInteraction": {
    "enabled": true,
    // 互动触发半径（像素）
    "detectRadius": 130,
    // 同一对宠物的互动冷却（毫秒），避免相遇时疯狂触发
    "cooldownMs": 20000,
    // 各类互动的基础概率（relation=普通时；好朋友/冤家会在此基础上偏移）
    "snuggleChance": 0.20,
    "chaseChance": 0.10
  },

  "workStatusDetector": {
    "enabled": true,
    // 采样间隔（秒）。5 是平衡点：更密费电，更疏状态滞后。
    "detectIntervalSec": 5,
    // 防抖：连续命中同一档位 N 次才切换（用户 Alt+Tab 很频繁，没有防抖会疯狂切动画）
    "confirmCount": 2,
    // 进入新档位后至少保持这么多秒，防止闪烁
    "minStateDurationSec": 10,
    // 前台窗口内容超过这么多分钟没变 → 判为"发呆"
    "idleThresholdMin": 3,
    // 连续工作这么久 → 触发一次"完成一段"（stepDone 里程碑，心情 +12）
    "workStretchMin": 25,
    // 连续工作这么久 → 触发"该休息了"（longDone 里程碑，心情 +10）
    "longWorkStretchMin": 50,
    // 自定义规则：**优先于内置规则**。格式 [{\"match\":{\"process\":[\"进程名\"],\"titleContains\":[\"关键词\"]},\"state\":\"档位\"}]
    // 档位可选：thinking / working / result / waiting / success / error / hold（hold = 保持不动）
    // 例：把 PyCharm 从 working 改成 thinking → [{\"match\":{\"process\":[\"pycharm64\"]},\"state\":\"thinking\"}]
    "customRules": []
  },

  "physics": {
    "gravity": 1600,
    "restitution": 0.86,
    "groundFriction": 2,
    "ceilingBounce": true,
    "throwPower": 1.15,
    "petCollision": false
  },
